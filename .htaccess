DirectoryIndex index.html
Options -Indexes

# Fichiers de configuration et de travail jamais servis
<FilesMatch "^(config(\.exemple)?\.php|README\.md|\.ovhconfig)$">
    Require all denied
</FilesMatch>

# Forcer le HTTPS
RewriteEngine On
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
